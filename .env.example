# GLM-ASR API 密钥配置
# 获取方式：
# 1. 访问 https://open.bigmodel.cn/
# 2. 注册账号并登录
# 3. 进入控制台 -> API Keys
# 4. 创建新的 API Key
GLM_API_KEY=your_api_key_here

# 豆包 API 密钥配置
# 获取方式：
# 1. 访问 https://console.volcengine.com/
# 2. 注册账号并登录
# 3. 进入控制台 -> API密钥管理
# 4. 创建 App ID 和 Access Key
DOUBAO_APP_ID=your_app_id_here
DOUBAO_ACCESS_KEY=your_access_key_here
DOUBAO_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# 豆包实时语音对话 API 配置（WebSocket 端到端模式）
# 获取方式：在语音大模型平台创建 API Key
DOUBAO_REALTIME_APP_ID=your_realtime_app_id_here
DOUBAO_REALTIME_ACCESS_KEY=your_realtime_access_key_here
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_APP_KEY=PlgvMymc7f3tQnJ6
